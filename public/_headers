/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; script-src-attr 'none'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.telegram.org; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests

# scripts/build-seo.mjs adds the exact JSON-LD hash to script-src in dist/_headers.
# Inline styles support the existing garment crop positions; inline scripts remain blocked.
# Telegram is the only permitted third-party connection for client-side appointment delivery.

/assets/index-*
  Cache-Control: public, max-age=31536000, immutable

/assets/cormorant-garamond-*
  Cache-Control: public, max-age=31536000, immutable

/assets/client/*
  Cache-Control: public, max-age=31536000, immutable
