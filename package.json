{
  "name": "kcreations",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "optimize:images": "node scripts/optimize-images.mjs",
    "prebuild": "npm run optimize:images",
    "build": "tsc -b && vite build && node scripts/build-seo.mjs",
    "check": "npm run lint && npm run build",
